# Copy to ~/.config/pinger/env (chmod 600). install.sh does this if the file is missing.
# Never commit the real file.

# Healthchecks.io ping URL (dead man's switch)
HC_URL=

# Telegram bot from @BotFather, and your chat id (@userinfobot)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Optional overrides (defaults live in ping.sh). Keep the quotes: the file is
# read by systemd and also sourced by bash for manual tests.
# CODEX_ACCOUNTS="codex1 codex2 codex3"
# AGY_MODELS="agy-gemini:gemini-3.8-flash-low agy-claude:gpt-oss-120b-medium"
